# Copy to .env (gitignored) and fill in. Astro loads .env into all containers.

# Google credentials mounted by docker-compose.override.yml. Points at your
# gcloud application-default login; swap for a service-account key file if you have one.
GOOGLE_APPLICATION_CREDENTIALS=/usr/local/airflow/gcloud/credentials.json
GOOGLE_CLOUD_PROJECT=greenhouse-energy-project

# Electricity Maps API key: read from dlt/.dlt/secrets.toml (mounted). Only set this to override it.
# SOURCES__ELECTRICITY_MAPS__API_KEY=   (leave commented if dlt/.dlt/secrets.toml has the key; an empty value overrides the file)

# BigQuery location of the datasets (used by the dbt profile)
BQ_LOCATION=US

# Cosmos runs `dbt ls` while parsing the DAG; the first (uncached) parse needs more than the 30s default.
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=120
AIRFLOW__DAG_PROCESSOR__DAG_FILE_PROCESSOR_TIMEOUT=180
